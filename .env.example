HOST=127.0.0.1
PORT=3000
NODE_ENV=development
# 留空使用默认路径；正式环境自动使用独立的 zheguang.production.sqlite。
# DB_PATH=./data/zheguang.sqlite
# 正式部署时设置 NODE_ENV=production、PUBLIC_ORIGIN 和以下管理员信息。
# 正式环境不会创建演示项目和演示成员，管理员密码至少 12 位。
# PUBLIC_ORIGIN=https://work.example.com
# DB_PATH=./data/zheguang.production.sqlite
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace-with-a-strong-password
